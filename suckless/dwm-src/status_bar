#!/bin/bash

# Función para obtener el brillo
get_brightness() {
    if command -v brightnessctl >/dev/null 2>&1; then
        brightnessctl -m | awk -F, '{print $4}' | tr -d '%'
    else
        echo "N/A"
    fi
}

while true; do
  # 1. Obtener la batería (BAT0 suele ser el estándar)
  BATTERY=$(cat /sys/class/power_supply/BAT0/capacity 2> /dev/null || echo "N/A")
  
  # 2. Formato de Fecha y Hora similar al de Waybar (Ej: Mon Apr 28, 10:30 PM)
  # %a (día corto), %b (mes corto), %d (día), %I:%M %p (12h con AM/PM)
  DATETIME=$(date "+%a %b %d, %I:%M %p")
  
  # 3. Obtener el volumen (limpiando corchetes y porcentaje)
  VOLUME=$(amixer get Master | grep -oP '\[\d+%\]' | head -1 | tr -d '[]%')
  [ -z "$VOLUME" ] && VOLUME="0"

  # 4. Obtener el brillo
  BRIGHTNESS=$(get_brightness)

  # 5. Construir la barra con el separador |
  # El orden: VOL | BAT | FECHA Y HORA
  xsetroot -name " VOL: $VOLUME% | BRI: $BRIGHTNESS% | BAT: $BATTERY% | $DATETIME "
  
  # Esperar 1 segundo para no saturar el sistema
  sleep 1
done
