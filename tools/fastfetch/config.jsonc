{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    {
      "type": "os",
      "key": "├── OS"
    },
    {
      "type": "kernel",
      "key": "│   ├── Kernel"
    },
    {
      "type": "uptime",
      "key": "│   ├── Uptime"
    },
    {
      "type": "processes",
      "key": "│   └── Processes"
    },

    {
      "type": "host",
      "key": "├── Host"
    },
    {
      "type": "board",
      "key": "│   ├── Motherboard"
    },
    {
      "type": "cpu",
      "key": "│   ├── CPU"
    },
    {
      "type": "gpu",
      "key": "│   ├── GPU"
    },
    {
      "type": "memory",
      "key": "│   ├── Memory"
    },
    {
      "type": "battery",
      "key": "│   └── Battery"
    },

    {
      "type": "display",
      "key": "├── Display"
    },
    {
      "type": "wm",
      "key": "│   ├── WM"
    },
    {
      "type": "de",
      "key": "│   └── DE"
    },

    {
      "type": "shell",
      "key": "├── Shell"
    },
    {
      "type": "terminal",
      "key": "│   ├── Terminal"
    },
    {
      "type": "init",
      "key": "│   └── Init System"
    },
    {
      "type": "packages",
      "key": "└── Packages"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": "block"
    }
  ]
}
